# ============================================================
# Playwright + Cucumber BDD Framework - environment variables
# Copy this file to `.env` and fill in the values for your target.
# NEVER commit the real `.env` file or real credentials.
# ============================================================

# Target environment: dev | qa | stage | prod
ENV=qa

# Optional override for the base URL defined in src/config/environments/<env>.ts
# BASE_URL=

# Browser selection: chromium | firefox | webkit
BROWSER=chromium

# Headless mode: true | false
HEADLESS=true

# Playwright action timeout in milliseconds
TIMEOUT=30000

# Retries (defaults: CI=1, local=0)
# RETRIES=

# Parallel workers (1 = sequential)
WORKERS=1

# Trace mode: on | off | retain-on-failure | on-first-retry
TRACE=on-first-retry

# Screenshot mode: only-on-failure | on | off
SCREENSHOT=only-on-failure

# Video mode: off | on | retain-on-failure
VIDEO=off

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Application credentials - populate in .env from a secret manager or CI secrets.
USERNAME=grace@zinc.test
PASSWORD=Passw0rd!

# Optional API base URL for API-based steps
# API_BASE_URL=
