# Dependencies
node_modules/

# Build output
dist/
build/

# Environment and secrets - never commit real credentials
.env
.env.*
!.env.example

# Test artifacts
reports/*
!reports/.gitkeep
allure-results/
allure-report/
playwright-report/
test-results/
screenshots/*
!screenshots/.gitkeep
videos/*
!videos/.gitkeep
traces/*
!traces/.gitkeep

# Logs
*.log
npm-debug.log*

# Cline runtime workflow state - never commit per-run state
.cline/state/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
